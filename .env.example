# 실제 키, 비밀번호는 .env 에 두고 커밋하지 않는다.

# ── DB (PostgreSQL) ──
# 비밀번호를 무작위값으로 변경 후 사용한다.
POSTGRES_DB=mitjip
POSTGRES_USER=mitjip
POSTGRES_PASSWORD=change-me-local

# ── 실행 환경 ──
# local / staging / production
APP_ENV=local
# 로그인 쿠키로 상태를 바꾸는 요청을 받아 줄 화면 주소. 3000 = Docker, 3100 = PC
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3100

# ── 내 PC 포트 (다른 프로그램과 겹칠 때만 바꾼다) ──
# PC에 PostgreSQL이 깔려 있으면 5432가 겹쳐서 DB는 5433으로 연다.
DB_HOST_PORT=5433
REDIS_HOST_PORT=6379
API_HOST_PORT=8000
# 웹 포트를 바꾸면 위 ALLOWED_ORIGINS에도 http://localhost:<그 포트>를 더한다 (안 그러면 로그인 · 가입이 막힌다)
WEB_HOST_PORT=3000

# ── AI ──
# false면 LLM을 부르지 않고 스텁 응답을 쓴다. CI는 항상 false.
LLM_LIVE=false
# OpenAI API Key
OPENAI_API_KEY=
# Claude API 키 (console.anthropic.com에서 발급). 도배 상담 에이전트가 쓴다. 커밋하지 않는다
ANTHROPIC_API_KEY=
# 에이전트가 쓰는 Claude 모델과 생각 깊이(low · medium · high)
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=medium
# 역할별 모델. 비워 두면 LLM_MODEL을 쓴다
# ROUTER: 상담 라우터(바꿀 칸 · 질문 나누기) · EXPERT: 공정 전문가 답 · PLAN: 공정 의견 · SOURCING: 가견적
# JUDGE: 평가 판정 (evaluation/에서 에이전트 답을 점수로 매긴다. 서비스는 쓰지 않는다)
LLM_MODEL_ROUTER=
LLM_MODEL_EXPERT=
LLM_MODEL_PLAN=
LLM_MODEL_SOURCING=
LLM_MODEL_JUDGE=
# 역할별 생각 깊이(low · medium · high). 비워 두면 LLM_EFFORT를 쓴다
LLM_EFFORT_ROUTER=low
LLM_EFFORT_EXPERT=low
LLM_EFFORT_PLAN=medium
LLM_EFFORT_SOURCING=low
LLM_EFFORT_JUDGE=low
# 공정 의견 캐시 시간(초). 입력이 같으면 LLM을 다시 부르지 않는다. 0이면 끈다
LLM_PLAN_CACHE_S=86400

# ── 외부 업체 정보 (가견적) ──
# 공공데이터포털 '일반 인증키(Decoding)'. KISCON 건설업체정보 · 국세청 사업자 상태조회 활용신청 뒤 넣는다.
# 비워 두면 수집 작업을 부르지 않고 건너뛴다. 커밋하지 않는다
DATA_GO_KR_KEY=
# 카카오 REST API 키 (선택). 넣으면 외부 업체의 카카오맵 장소 ID만 맞춰 둔다 (검색 결과의 전화 · 주소는 저장하지 않는다).
# 비워 두면 건너뛴다. 커밋하지 않는다
KAKAO_REST_KEY=
# 수집기 User-Agent에 붙일 연락 주소 (예: https://도메인/bot). 사이트 운영자가 믿집에 연락할 곳
BOT_CONTACT_URL=
# 업체 홈페이지 확인기: 요청 사이 간격(초) · 한 요청 시간 제한(초). robots.txt의 Crawl-delay가 더 길면 그것을 따른다
CRAWL_INTERVAL_S=3
CRAWL_TIMEOUT_S=10
# 외부 업체에 믿집이 대신 연락하기. 법무 검토 전에는 false로 둔다 (false면 요청은 queued에서 멈추고 보내지 않는다)
CONTACT_SEND_ENABLED=false
# 대신 연락 하루 한도 (서울 날짜): 고객 한 명이 만드는 요청 수 · 업체 한 곳이 받는 요청 수
CONTACT_DAILY_PER_CUSTOMER=5
CONTACT_DAILY_PER_VENDOR=2
# 대신 연락 메시지 끝에 밝힐 믿집 연락처(전화 · 이메일). 비어 있으면 켜져 있어도 보내지 않는다
CONTACT_SENDER_CONTACT=
# 수신거부 링크를 만들 웹 주소 (끝에 /opt-out?t=... 를 붙인다)
WEB_URL=http://localhost:3000
# worker 주기 작업 (서울 시각). false면 아래를 모두 돌리지 않는다
#   대신 연락 보내기 5분마다 (CONTACT_SEND_ENABLED=false면 아무것도 안 함) · 멈춘 발송 정리 10분마다 ·
#   KISCON 공시 매일 04:10 (DATA_GO_KR_KEY가 없으면 건너뜀) · 업체 홈페이지 확인 매주 월 04:40
CRON_ENABLED=true

# ── 로컬 시험 계정 ──
# 관리자 · 고객 · 업체 시험 계정에 같이 쓸 비밀번호(8자 이상). 넣어 두면 docker compose up 때 계정을 자동으로 만든다.
# 비워 두면 만들지 않는다. 로컬(APP_ENV=local)에서만 쓴다.
SEED_PASSWORD=
