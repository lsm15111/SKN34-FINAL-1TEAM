# 실제 키, 비밀번호는 .env 에 두고 커밋하지 않는다.

# ── DB (PostgreSQL) ──
# 비밀번호를 무작위값으로 변경 후 사용한다.
POSTGRES_DB=mitjip
POSTGRES_USER=mitjip
POSTGRES_PASSWORD=change-me-local

# ── 실행 환경 ──
# local / staging / production
APP_ENV=local
# 로그인 쿠키로 상태를 바꾸는 요청을 받아 줄 화면 주소. 3000 = Docker, 3100 = PC
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3100
# true면 worker가 시연 업체(app/demo.py) 3곳의 일(실측 견적서 보내기 · 공사 날짜 내기)을 몇 초마다 대신 한다.
# 시연 서버에서만 켠다. production에서는 켜도 돌지 않는다.
DEMO_AUTO=false

# ── 내 PC 포트 (다른 프로그램과 겹칠 때만 바꾼다) ──
# PC에 PostgreSQL이 깔려 있으면 5432가 겹쳐서 DB는 5433으로 연다.
DB_HOST_PORT=5433
REDIS_HOST_PORT=6379
API_HOST_PORT=8000
# 웹 포트를 바꾸면 위 ALLOWED_ORIGINS에도 http://localhost:<그 포트>를 더한다 (안 그러면 로그인 · 가입이 막힌다)
WEB_HOST_PORT=3000

# ── AI ──
# false면 LLM을 부르지 않고 스텁 응답을 쓴다. CI는 항상 false.
LLM_LIVE=false
# OpenAI API Key
OPENAI_API_KEY=
# 에이전트가 쓰는 모델과 추론 강도
OPENAI_AGENT_MODEL=gpt-6.1-terra
OPENAI_REASONING_EFFORT=low
# 사용자별 일일 토큰 제한. 측정 뒤 정한다
AGENT_DAILY_TOKEN_LIMIT=
# 직접 학습한 의도 분류 모델 경로와 신뢰도 기준값. 측정 뒤 정한다
INTENT_MODEL_PATH=
INTENT_CONFIDENCE_THRESHOLD=
# 신뢰도가 낮을 때 부르는 Jev. 입구 분류에만 쓴다
OPENROUTER_API_KEY=
JEV_MODEL=typesafe/jev-1.14
# 문서 검색용 임베딩 · 리랭커
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
VOYAGE_API_KEY=
VOYAGE_RERANK_MODEL=rerank-3
# 믿집 일정 MCP 서버 주소와 내 PC 포트
MCP_SERVER_URL=http://mcp:8001/mcp
MCP_HOST_PORT=8001

# ── 로컬 시험 계정 ──
# 관리자 · 고객 · 업체 시험 계정에 같이 쓸 비밀번호(8자 이상). 넣어 두면 docker compose up 때 계정을 자동으로 만든다.
# 비워 두면 만들지 않는다. 로컬(APP_ENV=local)에서만 쓴다.
SEED_PASSWORD=
