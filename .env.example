# 실제 키, 비밀번호는 .env 에 두고 커밋하지 않는다.

# ── DB (PostgreSQL) ──
# 비밀번호를 무작위값으로 변경 후 사용한다.
POSTGRES_DB=mitjip
POSTGRES_USER=mitjip
POSTGRES_PASSWORD=change-me-local

# ── 실행 환경 ──
# local / staging / production
APP_ENV=local
# 로그인 쿠키로 상태를 바꾸는 요청을 받아 줄 화면 주소. 3000 = Docker, 3100 = PC
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3100
# true면 worker가 시연 업체(app/demo.py) 3곳의 일(실측 견적서 보내기 · 공사 날짜 내기)을 몇 초마다 대신 한다.
# 시연 서버에서만 켠다. production에서는 켜도 돌지 않는다.
DEMO_AUTO=false
# 화면(Next) CSP를 막지 않고 알리기만 할지(true). 비우면 막는다. CSP를 처음 켜거나 화면이 깨졌을 때 잠깐만 쓴다
CSP_REPORT_ONLY=
# 실시간 줄기(Redis Stream) 키 앞에 붙는 말. 비우면 mj:{APP_ENV}. 같은 Redis를 여러 환경이 같이 쓸 때만 바꾼다
REALTIME_PREFIX=
# 화면 개발용 예시 데이터 모드(1이면 lib/mock 예시로 그린다). next dev에서만 켜지고 운영 빌드에서는 늘 꺼진다
NEXT_PUBLIC_MJ_MOCK=

# ── 몰릴 때 (API 프로세스 하나마다) ──
# DB 풀(5 + 넘침 5)에서 빈 연결을 기다리는 초. 넘으면 503과 Retry-After로 바로 거절한다
DB_POOL_TIMEOUT=3
# 동시에 도는 대화 턴(비서 · 업체 비서 · AI 칸) 자리. 다 차면 기다리지 않고 503과 Retry-After로 거절한다.
# 기본 10은 DB 풀 연결 수(5 + 넘침 5)와 같다. 풀을 키우면 같이 올린다
TURN_SLOTS=10
# 넘쳐서 거절할 때 다시 해 보라고 알려 줄 초(Retry-After)
BUSY_RETRY_AFTER=5

# ── 내 PC 포트 (다른 프로그램과 겹칠 때만 바꾼다) ──
# PC에 PostgreSQL이 깔려 있으면 5432가 겹쳐서 DB는 5433으로 연다.
DB_HOST_PORT=5433
REDIS_HOST_PORT=6379
API_HOST_PORT=8000
# 웹 포트를 바꾸면 위 ALLOWED_ORIGINS에도 http://localhost:<그 포트>를 더한다 (안 그러면 로그인 · 가입이 막힌다)
WEB_HOST_PORT=3000

# ── AI ──
# false면 LLM을 부르지 않고 스텁 응답을 쓴다. CI는 항상 false.
LLM_LIVE=false
# LLM 공급자: anthropic(기본, Claude) 또는 openai. openai면 v4 비서 · 조사 · 기억 · 먼저 말 걸기도 OpenAI로 가고
# 도면 읽기만 꺼진다(docs/v4/10-openai.md). 임베딩은 공급자와 상관없이 OpenAI 키를 쓴다
LLM_PROVIDER=anthropic
# Anthropic API Key
ANTHROPIC_API_KEY=
# Claude API 주소. 환경의 ANTHROPIC_BASE_URL(Claude Code 같은 도구가 넣는 값)을 따라가지 않게 이 값을 쓴다
LLM_ANTHROPIC_BASE_URL=https://api.anthropic.com
# Claude 모델과 effort: 비서 · 도면 · 무거운 역할 / 짧은 문장 · 분류 · 기억 · 가벼운 역할 / 판정(평가에서만).
# CLAUDE_* · ANTHROPIC_* 이름은 Claude Code 같은 도구가 이미 쓰므로 LLM_CLAUDE_*로 둔다
LLM_CLAUDE_MODEL=claude-sonnet-5-5
LLM_CLAUDE_EFFORT=medium
LLM_CLAUDE_LIGHT_MODEL=claude-haiku-5-5
LLM_CLAUDE_LIGHT_EFFORT=low
LLM_CLAUDE_JUDGE_MODEL=claude-opus-5-5
# 가벼운 Claude 모델을 쓸 v2 · v3 역할 (쉼표로)
LLM_CLAUDE_LIGHT_ROLES=trade,composer,general,planner
# 유료 LLM 비용 상한(달러). 80%면 경고 로그, 90%면 유료 호출을 막고 무료 모드로 답한다. 0이면 모두 막는다
LLM_CAP_USER_DAY_USD=1.00
LLM_CAP_SERVICE_DAY_USD=5
LLM_CAP_TOTAL_USD=45
# 새 계정(가입한 지 LLM_NEW_USER_DAYS일 안 고객, 업체 · 관리자는 뺌) 몫: 한 계정 하루 · 새 계정 모두 합쳐 하루.
# 사용자 하루 상한과 함께 본다. 일수를 0으로 두면 새 계정 몫을 보지 않는다
LLM_CAP_NEW_USER_DAY_USD=0.20
LLM_CAP_NEW_POOL_DAY_USD=1
LLM_NEW_USER_DAYS=7
# 비서 한 턴 상한(달러)
LLM_CAP_TURN_USD=0.06
# 비서 조사 담당: 공사당 하루(서울 날짜) 조사 시작 수. 0이면 세지 않아요
ASSISTANT_RESEARCH_DAY_MAX=3
# 비서 answer_question이 질문 종류별로 부를 답 파이프라인(v2 · v3 · v2g · v2+v3 · v2g+v3 · expert · expert+v3). 'v3'면 모두, 'price=v3,*=v2+v3'처럼 종류=엔진(* = 나머지)
# v2g: v2 근거(지식 조각 · 공정 순서 · 되물을 조건)만 LLM 없이 받아 비서가 한 번에 써요. 금액 · 기간 질문은 v3로 넘겨요
# v2+v3: v2 먼저, v2가 범위 밖(다른 공정)으로 보고 v3가 답하면 v3. 금액 · 기간은 v3(계산 엔진 공정표 · 금액을 근거로)
# expert · expert+v3: 코드가 도배 · 목공을 고르고 공정 전문가(LLM 구조화 답)가 근거 번호 · 주의점 · 확인할 조건을 내요. 모르는 공정 · 실패는 v2g로
# 기본: 도배 · 목공 전문가가 근거를 내고 비서가 받아 정리해요(expert+v3, 2026-11-24 Opus 판정 뒤). 예전 기본은 *=v2g+v3
ASSISTANT_ANSWER_ROUTE=period=v3,price=v3,*=expert+v3
# 공정 전문가 모델: main(기본, 비서와 같은 모델 · 강도) · light('trade' 역할 기본 = 가벼운 모델)
ASSISTANT_EXPERT_MODEL=main
# 비서 지시문 판 묶음: v4(기본, 고객 customer_v4 · 업체 vendor_v4 · 먼저 말 걸기 문장 nudge_write_v3) 또는 v3(옛 판)
# v5는 고객 지시문만 줄인 판(customer_v5, 평가로 견주는 중)
ASSISTANT_PROMPT_SET=v4
# OpenAI API Key (임베딩 · OpenAI 길)
OPENAI_API_KEY=
# OpenAI 길(LLM_PROVIDER=openai)에서 에이전트가 쓰는 모델과 추론 강도
OPENAI_AGENT_MODEL=gpt-6.1-terra
OPENAI_REASONING_EFFORT=low
# 짧은 구조화 출력(공정 에이전트 등)용 작은 모델. 비우면 위 모델을 쓴다
OPENAI_LIGHT_MODEL=gpt-6-luna
OPENAI_LIGHT_EFFORT=none
# 작은 모델을 쓸 역할 (쉼표로)
OPENAI_LIGHT_ROLES=trade,composer,general,planner
# 무료 모드(LLM 다시 쓰기 없음)에서도 질문 임베딩으로 의미 검색을 같이 쓸지. 키가 있을 때만 써요(질문 1만 개 약 $0.05)
AI_EMBED_FREE=true
# 사용자별 일일 토큰 제한. 측정 뒤 정한다
AGENT_DAILY_TOKEN_LIMIT=
# 직접 학습한 의도 분류 모델(backend/app/agent/intent_lr_v1.json.gz)의 신뢰도 기준값. 이보다 낮으면 Jev (#70)
INTENT_CONFIDENCE_THRESHOLD=0.7
# 신뢰도가 낮을 때 부르는 Jev. 입구 분류에만 쓴다
OPENROUTER_API_KEY=
JEV_MODEL=typesafe/jev-1.14
# false면 Jev를 부르지 않고 학습 모델 라벨을 그대로 쓴다. Jev 효과를 비교하는 테스트용
JEV_ENABLED=true
# 문서 검색용 임베딩 · 리랭커
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
VOYAGE_API_KEY=
VOYAGE_RERANK_MODEL=rerank-3
# 믿집 일정 MCP 서버 주소와 내 PC 포트
MCP_SERVER_URL=http://mcp:8001/mcp
MCP_HOST_PORT=8001

# ── 로컬 시험 계정 ──
# 관리자 · 고객 · 업체 시험 계정에 같이 쓸 비밀번호(8자 이상). 넣어 두면 docker compose up 때 계정을 자동으로 만든다.
# 비워 두면 만들지 않는다. 로컬(APP_ENV=local)에서만 쓴다.
SEED_PASSWORD=
