# 믿집 환경변수. `cp .env.example .env` 한 뒤 `docker compose up --build` 하면 로컬에서 바로 뜬다.
# 실제 키 · 비밀번호는 .env 에만 둔다 (.env 는 커밋하지 않는다).
# 새 환경변수는 여기에 한국어 주석과 함께 더하고, 컨테이너에 넘겨야 하면 compose.yaml에도 더한다.

# ── DB (PostgreSQL) ──
# 로컬은 이대로 둬도 된다. 운영에서는 길고 무작위인 비밀번호로 바꾼다.
POSTGRES_PASSWORD=change-me-local
POSTGRES_DB=mitjip
POSTGRES_USER=mitjip

# ── 실행 환경 ──
# local / staging / production
APP_ENV=local
# 로그인 쿠키로 상태를 바꾸는 요청을 받아 줄 화면 주소 (쉼표로 구분). 3000 = Docker 웹, 3100 = PC에서 띄운 웹
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3100

# ── 내 PC 포트 (다른 프로그램과 겹칠 때만 바꾼다) ──
# PC에 PostgreSQL이 깔려 있으면 5432가 겹쳐서 DB는 5433으로 연다.
DB_HOST_PORT=5433
REDIS_HOST_PORT=6379
API_HOST_PORT=8000
WEB_HOST_PORT=3000

# ── AI ──
# false면 LLM을 부르지 않고 스텁 응답을 쓴다 (유료 호출 0회). CI는 항상 false.
LLM_LIVE=false
# LLM_LIVE=true 일 때만 필요하다.
OPENAI_API_KEY=
