# 실제 키, 비밀번호는 .env 에 두고 커밋하지 않는다.

# ── DB (PostgreSQL) ──
# 비밀번호를 무작위값으로 변경 후 사용한다.
POSTGRES_DB=mitjip
POSTGRES_USER=mitjip
POSTGRES_PASSWORD=change-me-local

# ── 실행 환경 ──
# local / staging / production
APP_ENV=local
# 로그인 쿠키로 상태를 바꾸는 요청을 받아 줄 화면 주소. 3000 = Docker, 3100 = PC
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3100

# ── 내 PC 포트 (다른 프로그램과 겹칠 때만 바꾼다) ──
# PC에 PostgreSQL이 깔려 있으면 5432가 겹쳐서 DB는 5433으로 연다.
DB_HOST_PORT=5433
REDIS_HOST_PORT=6379
API_HOST_PORT=8000
WEB_HOST_PORT=3000

# ── AI ──
# false면 LLM을 부르지 않고 스텁 응답을 쓴다. CI는 항상 false.
LLM_LIVE=false
# OpenAI API Key
OPENAI_API_KEY=
